# Contoh konfigurasi backend SIMITI — salin jadi .env lalu isi nilainya.
# JANGAN commit file .env yang berisi password/API key asli.

# --- Database PostgreSQL/PostGIS ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=simiti
DB_USER=postgres
DB_PASSWORD=ganti_dengan_password_db

# --- Autentikasi (wajib diganti di server; dipakai juga untuk endpoint AI) ---
JWT_SECRET=ganti_dengan_string_acak_panjang

# --- AI Rekomendasi Mitigasi (OpenAI) ---
# Buat key di https://platform.openai.com/api-keys (akun organisasi harus punya saldo).
OPENAI_API_KEY=
# Default gpt-6-luna. gpt-4.1-mini masih jalan tapi dihentikan OpenAI 14 Jan 2027.
OPENAI_MODEL=gpt-6-luna
# Batas waktu panggilan OpenAI (ms)
OPENAI_TIMEOUT_MS=90000

# Wajib login untuk menjalankan analisis AI (true/false)
AI_REQUIRE_AUTH=true
# Maksimal analisis AI per pengguna per jam (0 = tanpa batas)
AI_RATE_LIMIT_PER_HOUR=30
# Hasil untuk wilayah + hazard yang sama disimpan sementara (menit) agar hemat kredit
AI_CACHE_TTL_MINUTES=30
# Batas waktu tiap query PostGIS saat mengumpulkan evidence (ms)
AI_EVIDENCE_QUERY_TIMEOUT_MS=15000
